{
  "manifest_version": 3,
  "name": "Tab Collections Manager",
  "version": "0.1.0",
  "description": "Manage and organize your tabs into collections. Hide and show collections with a single click.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-collections-manager@example.org",
      "strict_min_version": "109.0"
    }
  },
  
  "permissions": [
    "tabs",
    "tabGroups",
    "tabHide",
    "storage",
    "contextualIdentities",
    "cookies"
  ],
  
  "background": {
    "scripts": [
      "shared/logger.js",
      "background/storage.js",
      "background/actions.js",
      "background/listeners.js",
      "background.js"
    ]
  },
  
  "action": {
    "default_title": "Tab Collections Manager",
    "default_icon": {
      "16": "icons/icon-16.svg",
      "32": "icons/icon-32.svg"
    }
  },
  
  "commands": {
    "open-manager": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+E"
      },
      "description": "Open Tab Collections Manager"
    }
  },
  
  "icons": {
    "16": "icons/icon-16.svg",
    "32": "icons/icon-32.svg",
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  }
}
